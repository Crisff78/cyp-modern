# Copy to .env and replace JWT_SECRET and DATABASE_URL for your local PostgreSQL.
DEMO_MODE=true
JWT_SECRET=replace-with-a-cryptographically-random-secret-of-32-plus-characters
DATABASE_URL=postgresql://cyp:your-local-password@127.0.0.1:5432/cyp
HOST=127.0.0.1
PORT=3001
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:5174
COLLECTOR_URL=http://127.0.0.1:5174
# No Docker or SQL Server is used.
# Non-demo requires DEMO_MODE=false, ADMIN_EMAIL, ADMIN_PASSWORD.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=replace-with-a-unique-password-at-least-14-characters

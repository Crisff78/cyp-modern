# Public template. Copy to .env; .env is ignored by Git.
# Never put real credentials or customer data in this tracked file.
# DEMO_MODE=true with an empty DATABASE_URL uses a local demo file.
# If DATABASE_URL is set, demo mode reads that PostgreSQL database. Use only
# a dedicated database with fictitious data; do not point demo mode at real data.
DEMO_MODE=true
JWT_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=
DATABASE_URL=
HOST=127.0.0.1
PORT=3001
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:5174
COLLECTOR_URL=http://127.0.0.1:5174
# RRAA: private company endpoint/client identifier, configured only in API.
# Leave both empty to disable station validation. Never use real RRAA in public demo.
RRAA_ENDPOINT=
RRAA_CLIENT_ID=
RRAA_TIMEOUT_MS=8000

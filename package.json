{
  "name": "cobros-y-pagos",
  "version": "0.1.0",
  "private": true,
  "description": "Operaciones de cobros, pagos y cuadre. Dos portales web, una API.",
  "workspaces": [
    "app/server",
    "app/client-admin",
    "app/client-collector"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @cyp/server test",
    "db:migrate": "pnpm --filter @cyp/server db:migrate",
    "start:local": "node scripts/start-local.mjs",
    "db:review": "pnpm --filter @cyp/server exec tsx --env-file-if-exists=../../.env scripts/seed-review.ts",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "format": "prettier --write \"app/**/*.{ts,tsx,css,json,html,js,sql}\" \"docs/*.md\" README.md --ignore-unknown",
    "db:backup": "node --env-file-if-exists=.env app/server/scripts/db-backup.mjs",
    "db:restore": "node --env-file-if-exists=.env app/server/scripts/db-restore.mjs",
    "db:parity": "node --env-file-if-exists=.env app/server/scripts/db-parity.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "typescript": "^5.9.3",
    "@types/node": "^22.19.0",
    "prettier": "^3.6.2"
  },
  "packageManager": "pnpm@12.4.2+sha512.08adc6613180275c7c9edada39dcf08c9c61ad4e7eaf330a4f3461f102b0f907423454d117f98e72d47fef0616070644d7bffc973a6a57f5090a6d7c368b07c9"
}
